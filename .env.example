APP_NAME="Surat SMKN 1 Amuntai"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://surat.test

APP_LOCALE=id
# Cadangan sengaja "en", bukan "id": bila sebuah kunci terjemahan belum ada di
# lang/id, pesan bahasa Inggris bawaan Laravel masih terbaca — sementara
# cadangan "id" membuatnya tampil sebagai kunci mentah seperti
# "validation.required", yang tidak berarti apa-apa bagi staf.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — Supabase Postgres
#
# DB_SEARCH_PATH=app,public sangat penting:
#   - Tabel milik Laravel (users, sessions, jobs, cache, migrations, aktivitas)
#     dibuat di schema "app" karena schema pertama pada search_path yang dipakai
#     saat membuat tabel baru.
#   - Tabel milik n8n (surat_tugas, siswa, pegawai, ...) tetap terbaca dari
#     schema "public" tanpa perlu menulis prefix.
# Inilah penegakan teknis keputusan K4 di docs/specs/dashboard-laravel-surat.md.
# JANGAN mengubahnya menjadi "public" — migration Laravel akan membuat tabel di
# tengah-tengah tabel n8n.
#
# Ambil nilainya dari Supabase → Project Settings → Database → Connection string.
# Gunakan koneksi "Session pooler" atau "Direct connection"; koneksi
# "Transaction pooler" (port 6543) tidak mendukung prepared statement yang
# dipakai PDO.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SEARCH_PATH=app,public
DB_SSLMODE=require

# ---------------------------------------------------------------------------
# n8n — seluruh logika surat (persetujuan, penomoran, PDF, notifikasi)
#
# N8N_SECRET adalah kode akses yang dulu diketik staf di gate dashboard lama.
# Sekarang menjadi kredensial server: dikirim sebagai header x-dashboard-secret
# dan TIDAK PERNAH sampai ke browser. Ini keputusan K5.
# ---------------------------------------------------------------------------
N8N_BASE_URL=https://n8n.dewakreatif.com/webhook
N8N_SECRET=
N8N_TIMEOUT=15

# ---------------------------------------------------------------------------
# Akun TAS pertama, dipakai sekali oleh "php artisan db:seed".
#
# Boleh dibiarkan kosong: seeder akan menanyakannya saat dijalankan dari
# terminal, sehingga kata sandi tidak perlu singgah di berkas mana pun.
# Isi hanya bila menjalankan seeder tanpa terminal interaktif, lalu hapus
# kembali setelah akunnya jadi.
# ---------------------------------------------------------------------------
SEED_TAS_EMAIL=
SEED_TAS_PASSWORD=

# ---------------------------------------------------------------------------
# Supabase Storage — tempat n8n menyimpan PDF surat.
#
# Kolom pdf_url pada tabel surat hanya berisi nama objek ("SK-3.pdf"), bukan
# URL, dan bucket-nya privat. Tanpa dua nilai di bawah ini, tombol unduh pada
# surat keterangan tidak berfungsi: webhook /surat-pdf milik n8n hanya
# melayani surat tugas.
#
# SUPABASE_SERVICE_KEY berkewenangan penuh dan melewati seluruh RLS. Ia hanya
# boleh hidup di server dan tidak pernah dikirim ke browser.
# Ambil dari Supabase → Project Settings → API → service_role.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET_SURAT=surat
SUPABASE_TTL_URL=300

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
