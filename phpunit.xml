<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>

        <!--
            Dipatok di sini, bukan diwarisi dari .env milik masing-masing
            mesin. Tes yang memeriksa batas hari WITA harus memberi hasil yang
            sama di mana pun ia dijalankan; tanpa ini, mesin yang .env-nya
            belum memuat APP_TIMEZONE akan menjalankannya pada UTC dan gagal
            karena alasan yang tidak terlihat dari berkas tesnya.

            Nilai ini juga menjadi timezone sesi Postgres lewat
            config/database.php — keduanya wajib sama. Alasannya panjang dan
            ada di sana.
        -->
        <env name="APP_TIMEZONE" value="Asia/Makassar"/>

        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Postgres lokal, bukan SQLite dan bukan Supabase.

            SQLite tidak dipakai karena tes riwayat dan data master menuntut
            tabel milik n8n di schema public dengan tipe khas Postgres.
            Supabase produksi tidak boleh dipakai karena RefreshDatabase
            menjalankan migrate:fresh, yang menghapus seluruh tabel pada
            search_path, termasuk data surat sekolah.

            Port 5433 bukan 5432: dipilih supaya tidak ada satu pun nilai di
            sini yang kebetulan cocok dengan koneksi produksi. Kredensial di
            bawah hanya berlaku untuk server di 127.0.0.1 dan memang boleh
            ikut ter-commit.

            Penyiapan sekali di mesin baru:
              psql -p 5433 -U postgres -c "create role surat_test login password 'surat_test'"
              psql -p 5433 -U postgres -c "create database surat_uji owner surat_test"
              psql -p 5433 -U surat_test -d surat_uji -c "create schema app authorization surat_test"
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5433"/>
        <env name="DB_DATABASE" value="surat_uji"/>
        <env name="DB_USERNAME" value="surat_test"/>
        <env name="DB_PASSWORD" value="surat_test"/>
        <env name="DB_SEARCH_PATH" value="app,public"/>
        <env name="DB_SSLMODE" value="prefer"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
