          "id": "s07rEDXvFHZKzoUU",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "url": "https://sapa.smkn1amuntai.sch.id/template/surat_tugas_template.html",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "html"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
