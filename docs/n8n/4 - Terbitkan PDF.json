    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.*,\n  json_agg(json_build_object(\n    'nama', p.nama, 'nip', p.nip,\n    'pangkat_golongan', p.pangkat_golongan, 'jabatan', p.jabatan\n  ) ORDER BY p.nama) AS petugas\nFROM surat_tugas s\nJOIN surat_tugas_petugas sp ON sp.surat_tugas_id = s.id\nJOIN pegawai p              ON p.id = sp.pegawai_id\nWHERE s.id = $1::int\nGROUP BY s.id;",
        "options": {
          "queryReplacement": "={{ [ $json.surat_tugas_id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        272,
        0
      ],
