      ],
      "id": "a6c11d87-f12d-4ea1-9057-573c782f44c7",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const data = $('Siapkan Data').first().json;\nlet tpl = $input.first().json.html;\n\nconst m = tpl.match(/{{#each petugas}}([\\s\\S]*?){{\\/each}}/);\nlet rows = '';\nfor (const p of data.petugas) {\n  let r = m[1];\n  for (const k of Object.keys(p)) r = r.split('{{' + k + '}}').join(p[k] ?? '');\n  rows += r;\n}\ntpl = tpl.replace(m[0], rows);\n\nfor (const k of Object.keys(data)) {\n  if (k === 'petugas') continue;\n  tpl = tpl.split('{{' + k + '}}').join(data[k] ?? '');\n}\n\nreturn [{\n  json: {},\n  binary: {\n    index_html: {\n      data: Buffer.from(tpl).toString('base64'),\n      mimeType: 'text/html',\n      fileName: 'index.html'\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
