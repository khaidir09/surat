    {
      "parameters": {
        "jsCode": "const s = $('Ambil Detail').first().json;\n\nconst inputTgl = $('When Executed by Another Workflow').first().json.tanggal_surat;\nconst tglSurat = inputTgl ? new Date(inputTgl + 'T00:00:00') : new Date();\n\nconst mulai   = new Date(s.tanggal_mulai);\nconst selesai = new Date(s.tanggal_selesai || s.tanggal_mulai);\nconst hari    = Math.round((selesai - mulai) / 86400000) + 1;\n\nconst bulan = ['Januari','Februari','Maret','April','Mei','Juni','Juli',\n  'Agustus','September','Oktober','November','Desember'];\nconst fmt = d => `${d.getDate()} ${bulan[d.getMonth()]} ${d.getFullYear()}`;\n\nreturn [{ json: {\n  nama_sekolah: 'SMK NEGERI 1 AMUNTAI',\n  nama_sekolah_singkat: 'SMKN 1 Amuntai',\n  alamat_sekolah: 'Jl. Negara Dipa No.346 Telp / Fax (0527) 61440 Amuntai 71418',\n  email_sekolah: 'smkn1amuntai@gmail.com',\n  jabatan_pemberi: 'Kepala Sekolah Menengah Kejuruan ( SMK ) Negeri 1 Amuntai',\n  wilayah_sekolah: 'Kabupaten Hulu Sungai Utara Provinsi Kalimantan Selatan',\n  nama_kepala: 'Syaprudin, S.Pd',\n  nip_kepala: '19791023 200604 1 006',\n  pangkat_kepala: 'Pembina Tingkat 1/IV-b',\n  kota_surat: 'Hulu Sungai Utara',\n  no_surat: `800.1.11.1/${$('When Executed by Another Workflow').first().json.no_surat}-SMKN.1-AT/${new Date().getFullYear()}`,\n  petugas: s.petugas.map((p, i) => ({\n    no: i + 1, nama: p.nama, nip: p.nip,\n    pangkat: p.pangkat_golongan, jabatan: p.jabatan, ket: ''\n  })),\n  keperluan: s.kegiatan,\n  tempat_tujuan: s.tempat,\n  lama_perjalanan: `${hari} hari`,\n  tanggal_berlaku: mulai.getTime() === selesai.getTime()\n    ? fmt(mulai) : `${mulai.getDate()} s.d ${fmt(selesai)}`,\n  alat_angkutan: 'Angkutan Darat/kendaraan roda empat/roda dua',\n  pembebanan_biaya: s.pembebanan_biaya || '-',\n  tanggal_surat: `${tglSurat.getDate()} ${bulan[tglSurat.getMonth()]} ${tglSurat.getFullYear()}`,\n  surat_id: s.id,\n  pemohon: s.pemohon_wa,\n  created_at: s.created_at\n}}];"
      },
