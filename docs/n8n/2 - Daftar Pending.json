    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT st.id, 'surat_tugas' AS jenis, st.status, st.created_at,\n       st.kegiatan, st.tempat, st.tanggal_mulai, st.tanggal_selesai,\n       COALESCE(json_agg(json_build_object('nama',p.nama,'jabatan',p.jabatan) ORDER BY p.nama)\n                FILTER (WHERE p.id IS NOT NULL), '[]'::json) AS petugas,\n       NULL::text AS nama_siswa, NULL::text AS kelas_jurusan, NULL::text AS keperluan\nFROM surat_tugas st\nLEFT JOIN surat_tugas_petugas sp ON sp.surat_tugas_id = st.id\nLEFT JOIN pegawai p ON p.id = sp.pegawai_id\nWHERE st.status IN ('menunggu','menunggu_ttd')\nGROUP BY st.id\n\nUNION ALL\n\nSELECT sk.id, 'keterangan_aktif' AS jenis, sk.status, sk.created_at,\n       NULL::text, NULL::text, NULL::date, NULL::date,\n       '[]'::json AS petugas,\n       s.nama, (s.kelas || '/' || s.jurusan), sk.keperluan\nFROM surat_keterangan sk\nJOIN siswa s ON s.id = sk.siswa_id\nWHERE sk.status = 'menunggu'\nORDER BY created_at ASC;",
        "options": {}
      },
